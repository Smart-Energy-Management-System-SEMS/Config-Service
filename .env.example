CONFIG_SERVICE_PORT=8090
CONFIG_SOURCE_PATH=Config
ENVIRONMENT=local

API_GATEWAY_PORT=8081
API_GATEWAY_BASE_URL_LOCAL=http://localhost:8081
API_GATEWAY_BASE_URL_DEPLOY=PENDING_CONFIGURATION
API_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_GATEWAY_AUTH_REQUIRED=false
API_GATEWAY_TIMEOUT_SECONDS=30

# Default/fallback (se usa si no defines *_LOCAL)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Cuando el cliente corre en host (GoLand, go run, python local, etc.)
KAFKA_BOOTSTRAP_SERVERS_LOCAL=localhost:29092
# Cuando el cliente corre dentro de Docker Compose
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=NONE
KAFKA_SASL_USERNAME=PENDING_CONFIGURATION
KAFKA_SASL_PASSWORD=PENDING_CONFIGURATION

# Device Management Service
DEVICE_MANAGEMENT_SERVICE_NAME=device-management-service
DEVICE_MANAGEMENT_BASE_URL_LOCAL=http://localhost:8083
DEVICE_MANAGEMENT_BASE_URL_DEPLOY=PENDING_CONFIGURATION
DEVICE_MANAGEMENT_ROUTE_PREFIX=/api/v1/device-management
DEVICE_MANAGEMENT_APP_ENV=local
DEVICE_MANAGEMENT_DB_DRIVER=postgres
DEVICE_MANAGEMENT_AUTO_MIGRATE=false
DEVICE_MANAGEMENT_KAFKA_ENABLED=true
DEVICE_MANAGEMENT_KAFKA_BROKERS=localhost:9092
DEVICE_MANAGEMENT_KAFKA_CLIENT_ID=device-management-service
DEVICE_MANAGEMENT_KAFKA_CONSUMER_GROUP=device-management-group
DEVICE_MANAGEMENT_KAFKA_WRITE_TIMEOUT_MS=2000
DEVICE_MANAGEMENT_API_GATEWAY_ALLOWED_ORIGIN=http://localhost:8081
DEVICE_MANAGEMENT_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
DEVICE_MANAGEMENT_KAFKA_TOPIC_DEVICE_REGISTERED=device.registered
DEVICE_MANAGEMENT_KAFKA_TOPIC_DEVICE_STATUS_UPDATED=device.status.updated
DEVICE_MANAGEMENT_KAFKA_TOPIC_DEVICE_LINKED=device.linked
DEVICE_MANAGEMENT_KAFKA_TOPIC_DEVICE_UNLINKED=device.unlinked
DEVICE_MANAGEMENT_KAFKA_TOPIC_DEVICE_CONFIGURATION_UPDATED=device.configuration.updated
DEVICE_MANAGEMENT_KAFKA_TOPIC_DEVICE_EVENT_RECORDED=device.event.recorded

# Alert Service
ALERT_SERVICE_NAME=alert-service
ALERT_BASE_URL_LOCAL=http://localhost:8085
ALERT_BASE_URL_DEPLOY=PENDING_CONFIGURATION
ALERT_ROUTE_PREFIX=/api/v1
ALERT_SERVER_PORT=8085
ALERT_KAFKA_BROKERS=localhost:29092
ALERT_KAFKA_CONSUMER_GROUP=alert-service-group
ALERT_KAFKA_GROUP_ID=alert-service-group
ALERT_KAFKA_CONSUMPTION_TOPIC=energy.consumption.recorded
ALERT_KAFKA_TOPIC_DEVICE_READING_CREATED=energy.consumption.recorded
ALERT_MAIL_HOST=smtp.gmail.com
ALERT_MAIL_PORT=587
ALERT_MAIL_FROM=PENDING_CONFIGURATION
