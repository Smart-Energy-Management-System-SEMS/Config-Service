PORT=8080
IAM_SERVICE_URL=https://iam-service.<azure-container-app-domain>
SUBSCRIPTIONS_SERVICE_URL=https://subscriptions-service.<azure-container-app-domain>
PAYMENTS_SERVICE_URL=https://payments-service.<azure-container-app-domain>
DEVICE_SERVICE_URL=https://device-service.<azure-container-app-domain>
ALERTS_SERVICE_URL=https://alerts-service.<azure-container-app-domain>
ANALYTICS_SERVICE_URL=https://analytics-service.<azure-container-app-domain>
ENERGY_SERVICE_URL=https://energy-service.<azure-container-app-domain>
KAFKA_BROKERS=<your-kafka-bootstrap-server>:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=<your-kafka-username>
KAFKA_PASSWORD=<your-kafka-password>
KAFKA_CLIENT_ID=config-service
KAFKA_CONSUMER_GROUP=config-service-group
